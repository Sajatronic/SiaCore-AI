# External API keys — copy to .env and fill in values
GDELT_API_KEY=
MARKETAUX_API_TOKEN=
GNEWS_API_TOKEN=
NEWSDATA_API_KEY=

# LLM — pick one provider (shared OpenAI-compatible client)

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Groq free tier (~12k TPM): use low concurrency or switch to llama-3.1-8b-instant
LLM_MAX_CONCURRENT=1
LLM_PARALLEL_WORKERS=1
LLM_MIN_REQUEST_INTERVAL_SECONDS=2
LLM_MAX_RETRIES=4

# Google Gemini
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-2.0-flash

# Supabase REST API (catalog reads — suppliers, parts, inventory)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY

# Direct PostgreSQL connection (migrations + risk event persistence)
# Supabase -> Project Settings -> Connect -> ORM tab (pooler port 6543)
# Do NOT append ?pgbouncer=true — that is Prisma-specific.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Pipeline configuration
PIPELINE_VERSION=0.5.0
DATA_ROOT=../
CANONICAL_ENTITIES_PATH=data/canonical_entities.json
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6
ENTITY_LINK_CONFIDENCE_THRESHOLD=0.7
HITL_REVIEW_QUEUE_PATH=data/review_queue.json
PREFILTER_DROPS_PATH=data/prefilter_drops.json
RELEVANCE_MIN_SCORE=0.40
SUPPLY_CHAIN_SEARCH_QUERY=semiconductor OR supply chain OR factory shutdown OR sanctions OR port closure OR strike
PROVIDER_FETCH_LIMIT=25
PERSIST_EVENTS=true
PERSIST_REQUIRE_DB=false

# AI risk analysis (Phase 3)
# Events with severity >= PRIORITY are always analyzed when confidence passes.
# Medium-tier events (MIN..PRIORITY) are analyzed when MAX_EVENTS allows (0 = unlimited).
RISK_ANALYSIS_ENABLED=true
RISK_ANALYSIS_MIN_SEVERITY=50.0
RISK_ANALYSIS_MIN_CONFIDENCE=0.5
RISK_ANALYSIS_PRIORITY_SEVERITY=65.0
RISK_ANALYSIS_MAX_EVENTS=0

# Impact prediction (Phase 4)
IMPACT_PREDICTION_ENABLED=true
IMPACT_PREDICTION_MIN_SEVERITY=35.0
IMPACT_PREDICTION_LLM_REFINE=true
IMPACT_PREDICTION_MAX_LLM_REFINES=10
DEFAULT_LEAD_TIME_DAYS=21
