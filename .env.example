# Supabase frontend configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL of the separately deployed NexusFlow workflow API.
# Do not put SUPABASE_SERVICE_KEY or Nexar secrets in this file.
VITE_SCRAPER_WORKFLOW_URL=http://localhost:8000

# Optional: enable only if your API gateway requires a browser-visible token.
# Prefer network-level protection or a server-side proxy instead.
# VITE_SCRAPER_WORKFLOW_TOKEN=
