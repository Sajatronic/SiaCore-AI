# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا تضف .env أبداً إلى git.

# Supabase
SUPABASE_URL=https:*************************
SUPABASE_SERVICE_KEY=*****************************************

# Nexar API
NEXAR_CLIENT_ID=******************************
NEXAR_CLIENT_SECRET=******************************

# التحكم بالدفعات لتفادي حد Nexar API (rate limit)
# عدد القطع (MPN) القصوى في كل تشغيل واحد
MAX_PARTS_PER_RUN=2
# تأخير بالثواني بين كل طلب وطلب لـ Nexar
NEXAR_REQUEST_DELAY_SECONDS=1.0
# مسار ملف حفظ نقطة التوقف بين التشغيلات
CHECKPOINT_FILE=checkpoint.json
